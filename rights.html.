@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) body::before{opacity:.09}}
:root[data-theme="dark"] body::before{opacity:.09}
.flag{display:inline-block;width:36px;height:18px;vertical-align:-3px;margin-right:8px;border-radius:3px;background:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2060%2030%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3CclipPath%20id%3D%22t%22%3E%3Cpath%20d%3D%22M30%2C15h30v15zv15h-30zh-30v-15zv-15h30z%22/%3E%3C/clipPath%3E%3Cpath%20d%3D%22M0%2C0v30h60v-30z%22%20fill%3D%22%23012169%22/%3E%3Cpath%20d%3D%22M0%2C0L60%2C30M60%2C0L0%2C30%22%20stroke%3D%22%23fff%22%20stroke-width%3D%226%22/%3E%3Cpath%20d%3D%22M0%2C0L60%2C30M60%2C0L0%2C30%22%20clip-path%3D%22url%28%23t%29%22%20stroke%3D%22%23C8102E%22%20stroke-width%3D%224%22/%3E%3Cpath%20d%3D%22M30%2C0v30M0%2C15h60%22%20stroke%3D%22%23fff%22%20stroke-width%3D%2210%22/%3E%3Cpath%20d%3D%22M30%2C0v30M0%2C15h60%22%20stroke%3D%22%23C8102E%22%20stroke-width%3D%226%22/%3E%3C/svg%3E") center/cover;box-shadow:0 0 0 1px var(--line)}
body{position:relative;z-index:0}
.lead,h1{text-shadow:0 0 6px var(--bg),0 0 12px var(--bg)}
.acorn{height:30px;vertical-align:middle;background:#fff;border-radius:8px;padding:3px 6px;margin-right:8px;box-shadow:0 0 0 1px var(--line)}
.brand{display:flex;align-items:center;flex-wrap:wrap;gap:4px}
.pts{display:inline-flex;align-items:center;gap:6px;background:var(--paper);border:2px solid #d9a400;border-radius:999px;padding:4px 12px;font-weight:700}
.pop{position:fixed;left:50%;top:18%;transform:translateX(-50%);background:#d9a400;color:#221d33;font-weight:700;font-size:1.4rem;padding:8px 18px;border-radius:999px;pointer-events:none;animation:pop 1.3s ease forwards;z-index:9}
@keyframes pop{0%{opacity:0;transform:translate(-50%,10px) scale(.8)}20%{opacity:1;transform:translate(-50%,0) scale(1.08)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-30px)}}
.badges{display:flex;gap:10px;flex-wrap:wrap;margin:0 0 16px}
.badge{background:var(--paper);border:2px solid var(--line);border-radius:14px;padding:6px 12px;font-size:.95rem;opacity:.45}
.badge.got{opacity:1;border-color:#d9a400}
.teacher{margin-top:22px;border:2px dashed var(--line);background:var(--paper);border-radius:14px;padding:10px 16px;font-weight:700;width:100%}
.qrs{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.qrbox{background:#fff;color:#221d33;border:3px solid var(--line);border-radius:18px;padding:16px;text-align:center}
.qrbox h3{margin:0 0 10px;font-size:1.4rem}
.qrbox .qr{display:flex;justify-content:center;margin:0 auto 8px}
.qrbox small{word-break:break-all;color:#5d5875}
input.url{width:100%;font:inherit;font-size:1rem;padding:10px;border:2px solid var(--line);border-radius:10px;background:var(--paper);color:var(--ink)}
.gap.count{color:var(--muted)!important}
@media print{body::before,.top,.bar,.row,.teacher,.noprint{display:none!important}.qrbox{break-inside:avoid;border-color:#999}}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <div class="brand"><span class="flag" aria-hidden="true"></span><img class="acorn" alt="Acorn Training" src="data:image/png;base64,"><span><b>CAN</b> or <i>SHOULD</i>?</span></div>
    <div class="pts" title="Your points">⭐ <span id="ptsN">0</span></div>
    <div class="level" role="group" aria-label="Audio speed">
      <button id="sp0" onclick="setRate(0)">🐢 Very slow</button>
      <button id="sp1" onclick="setRate(1)">Slow</button>
      <button id="sp2" onclick="setRate(2)">Normal</button>
    </div>
    <div class="level" id="levelSw" role="group" aria-label="Level">
      <button id="lv1" class="on" onclick="setLevel(1)">Entry 1</button>
      <button id="lv2" onclick="setLevel(2)">Entry 2</button>
    </div>
  </div>

  <section id="home">
    <div class="hero">
      <div class="c"><strong>CAN</strong><span>A right. You are allowed to do it.</span></div>
      <div class="s"><strong>SHOULD</strong><span>A responsibility. People expect you to do it.</span></div>
    </div>
    <h1>Rights and Responsibilities in the UK</h1>
    <p class="lead">Choose a game. Tap 🔊 to listen.</p>
    <div class="badges" id="badges"></div>
    <div class="menu" id="menu"></div>
    <button class="teacher" onclick="teacher()">👩‍🏫 Teacher: QR codes and settings</button>
  </section>

  <section id="play" class="hide">
    <div class="bar">
      <button class="back" onclick="home()">◀ Games</button>
      <div class="prog"><i id="progFill"></i></div>
      <div class="count" id="count"></div>
    </div>
    <div id="stage"></div>
  </section>
</div>

