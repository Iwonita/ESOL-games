<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Rights and Responsibilities – CAN or SHOULD?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --bg:#f5f4fa; --paper:#ffffff; --ink:#221d33; --muted:#5d5875;
  --can:#3f8a2f; --can-soft:#e5f2df;
  --should:#5b3fa8; --should-soft:#ece6f8;
  --warn:#b8561c; --warn-soft:#fbe9dd;
  --line:#dcd8e8;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#16141d; --paper:#211e2b; --ink:#f0eef6; --muted:#aaa5bd;
    --can:#7cc76a; --can-soft:#1f3219; --should:#a993ea; --should-soft:#2a2340;
    --warn:#f0a070; --warn-soft:#3a2518; --line:#3a3548;
  }
}
:root[data-theme="dark"]{
  --bg:#16141d; --paper:#211e2b; --ink:#f0eef6; --muted:#aaa5bd;
  --can:#7cc76a; --can-soft:#1f3219; --should:#a993ea; --should-soft:#2a2340;
  --warn:#f0a070; --warn-soft:#3a2518; --line:#3a3548;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:"Atkinson Hyperlegible",Verdana,"Segoe UI",Arial,sans-serif;font-size:19px;line-height:1.45}
.wrap{max-width:760px;margin:0 auto;padding:18px 16px 48px}
button{font:inherit;cursor:pointer;color:inherit}
button:focus-visible{outline:3px solid var(--should);outline-offset:3px}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.brand{font-weight:700;font-size:1.05rem}
.brand b{color:var(--can)} .brand i{color:var(--should);font-style:normal}
.level{display:flex;border:2px solid var(--line);border-radius:14px;overflow:hidden;background:var(--paper)}
.level button{border:0;background:none;padding:8px 14px;font-weight:700;font-size:.95rem}
.level button.on{background:var(--ink);color:var(--paper)}
/* hero */
.hero{display:grid;grid-template-columns:1fr 1fr;border-radius:22px;overflow:hidden;margin-bottom:22px}
.hero div{padding:22px 20px}
.hero .c{background:var(--can);color:#fff}
.hero .s{background:var(--should);color:#fff}
.hero strong{display:block;font-size:2.4rem;line-height:1}
.hero span{font-size:1rem;opacity:.95}
h1{font-size:1.5rem;margin:0 0 4px}
.lead{color:var(--muted);margin:0 0 18px;font-size:1rem}
.menu{display:grid;gap:12px}
.game{display:flex;align-items:center;gap:16px;text-align:left;background:var(--paper);border:2px solid var(--line);
  border-radius:16px;padding:14px 16px}
.game:hover{border-color:var(--should)}
.game .ic{font-size:2rem;width:48px;text-align:center;flex:none}
.game h2{font-size:1.1rem;margin:0}
.game p{margin:2px 0 0;color:var(--muted);font-size:.92rem}
.game .best{margin-left:auto;font-size:.9rem;color:var(--muted);white-space:nowrap}
/* play */
.bar{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.back{border:2px solid var(--line);background:var(--paper);border-radius:12px;padding:6px 12px;font-size:.95rem}
.prog{flex:1;height:12px;background:var(--line);border-radius:6px;overflow:hidden}
.prog i{display:block;height:100%;background:var(--can);width:0;transition:width .3s}
.count{font-size:.95rem;color:var(--muted);white-space:nowrap}
.card{background:var(--paper);border:2px solid var(--line);border-radius:20px;padding:22px 20px;margin-bottom:14px}
.q{font-size:1.45rem;font-weight:700;margin:0 0 6px}
.q .gap{display:inline-block;min-width:4.2em;border-bottom:3px solid var(--muted);text-align:center}
.q .gap.can{color:var(--can);border-color:var(--can)} .q .gap.should{color:var(--should);border-color:var(--should)}
.emoji{font-size:2.6rem;line-height:1;margin-bottom:8px}
.say{border:0;background:var(--bg);border-radius:10px;padding:4px 10px;font-size:.95rem;margin-top:6px}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
.opt{border:3px solid var(--line);background:var(--paper);border-radius:16px;padding:16px 10px;font-size:1.25rem;font-weight:700}
.opt.can{border-color:var(--can);color:var(--can)} .opt.should{border-color:var(--should);color:var(--should)}
.opt.can:hover{background:var(--can-soft)} .opt.should:hover{background:var(--should-soft)}
.opt.right,.opt.right:hover{background:var(--can)!important;color:#fff!important;border-color:var(--can)!important}
.opt.wrong,.opt.wrong:hover{background:var(--warn)!important;color:#fff!important;border-color:var(--warn)!important}
.opt:disabled{cursor:default}
.fb{border-radius:16px;padding:14px 16px;margin-top:14px;display:none}
.fb.show{display:block}
.fb.ok{background:var(--can-soft)} .fb.no{background:var(--warn-soft)}
.fb strong{display:block;font-size:1.1rem}
.next{margin-top:12px;border:0;background:var(--ink);color:var(--paper);border-radius:12px;padding:10px 20px;font-weight:700}
.text{background:var(--bg);border-left:6px solid var(--should);border-radius:10px;padding:12px 14px;margin:6px 0 4px;font-size:1.05rem}
.persona{display:flex;gap:10px;align-items:center;margin-bottom:10px}
.persona span{font-size:2.2rem}
/* build */
.slot{min-height:64px;border:2px dashed var(--line);border-radius:14px;padding:8px;display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.tiles{display:flex;flex-wrap:wrap;gap:8px}
.tile{border:2px solid var(--should);background:var(--should-soft);border-radius:10px;padding:8px 12px;font-weight:700}
.slot .tile{border-color:var(--can);background:var(--can-soft)}
.row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.ghost{border:2px solid var(--line);background:var(--paper);border-radius:12px;padding:8px 16px;font-weight:700}
/* end */
.stars{font-size:3rem;letter-spacing:6px}
.review{margin:10px 0 0;padding-left:1.1em}
.review li{margin-bottom:8px}
.hide{display:none!important}
.big{font-size:1.6rem;font-weight:700;margin:6px 0}
.model{background:var(--can-soft);border-radius:12px;padding:12px 14px;margin-top:12px;font-weight:700}
.frame{color:var(--muted);font-size:1rem;margin-top:8px}
@media (max-width:480px){.hero strong{font-size:1.9rem}.q{font-size:1.25rem}}
@media (prefers-reduced-motion:reduce){.prog i{transition:none}}

