  {name:"Blessing",e:"✝️",text:"Blessing lives in Hanley and she works in a café. She is a Christian, so she goes to church every Sunday. Her manager knows this, so Blessing does not work on Sundays. She works on Saturdays instead. Blessing wears a small cross at work. One day, a customer says, “Take off that cross!” Blessing is upset, but she stays polite. Her manager says, “Blessing can wear her cross. In the UK, people can choose their religion.” The customer says sorry and leaves.",
   st:[["Blessing wears a cross at work.","RIGHT"],["Blessing stays polite.","RESPONSIBILITY"],["Blessing goes to church.","RIGHT"],["The customer should respect other people.","RESPONSIBILITY"],["Blessing works on Saturdays instead.","RESPONSIBILITY"],["Blessing does not have to take off her cross.","RIGHT"],["The customer says sorry.","RESPONSIBILITY"]]},
  {name:"Ahmed",e:"🗳️",text:"Ahmed lives in Stoke-on-Trent. He is 25 years old and he has a British passport, so he is eligible to vote. On election day, he goes to a polling station in a school near his home. He gives his name and gets a ballot paper. He goes into a small booth, so nobody can see his paper. He puts an X next to one name and puts the paper in the ballot box. His sister Sara is 15, so she cannot vote yet. She is disappointed, but she can vote when she is 18. Their neighbour, Mrs Green, is 82. She cannot walk far, so she votes by post.",
   st:[["Ahmed votes on election day.","RIGHT"],["Nobody can see Ahmed’s paper.","RIGHT"],["Ahmed follows the rules at the polling station.","RESPONSIBILITY"],["Mrs Green votes by post.","RIGHT"],["Ahmed gives his name at the polling station.","RESPONSIBILITY"],["Sara is disappointed but she is polite.","RESPONSIBILITY"],["Sara can vote when she is 18.","RIGHT"]]},
  {name:"Pavel",e:"🏭",text:"Pavel is from Poland and he works in a warehouse in Fenton. He works hard and he is always on time. Two workers, Dan and Lee, laugh at Pavel because of his accent. They do not talk to him at lunch, so Pavel feels lonely. This is discrimination, and it is against the law in the UK. Pavel is nervous, but he talks to his manager. The manager listens and talks to Dan and Lee. Now they work together, and Pavel is happy at work again. Everyone has a right to be treated fairly.",
   st:[["Pavel is always on time.","RESPONSIBILITY"],["Pavel is treated fairly at work.","RIGHT"],["Pavel says what he thinks to his manager.","RIGHT"],["Dan and Lee should respect Pavel.","RESPONSIBILITY"],["Pavel gets the same pay as the other workers.","RIGHT"],["Pavel is safe at work.","RIGHT"],["Pavel works hard.","RESPONSIBILITY"]]}
 ]
};

const BUILD = {
 1:["Blessing can choose her religion.","Ahmed can vote.","You should wait in the queue.","Pavel can say what he thinks.","Children can go to school.","We should put rubbish in the bin.","You can be safe at work.","You should be quiet at night."],
 2:["Ahmed can vote because he is 25.","Sara cannot vote because she is only 15.","You can say what you think, but you should be polite.","Mrs Green cannot walk far, so she votes by post.","Everyone is equal, so discrimination is against the law.","You can vote at a polling station or by post.","Blessing wears a cross, and her manager says it is fine.","Pavel talks to his manager because Dan and Lee are rude."]
};

const PEOPLE = [
 {n:"Blessing",e:"👩🏾",g:"f"},{n:"Ahmed",e:"👨🏽",g:"m"},{n:"Pavel",e:"👨🏼",g:"m"},{n:"Fatima",e:"🧕🏽",g:"f"},
 {n:"Amara",e:"👩🏿",g:"f"},{n:"Ali",e:"👨🏻",g:"m"},{n:"Mrs Green",e:"👵🏻",g:"f"},{n:"Mina",e:"👩🏻",g:"f"}
];

/* ---------- POINTS ---------- */
let STREAK=0;
const BADGES=[[50,"🥉 Bronze"],[150,"🥈 Silver"],[300,"🥇 Gold"],[500,"🏆 Champion"]];
function getPts(){return parseInt(store("rg-points-"+LEVEL)||"0")||0}
function drawPts(){$("ptsN").textContent=getPts();const b=$("badges");if(b)b.innerHTML=BADGES.map(([n,l])=>`<span class="badge ${getPts()>=n?"got":""}">${l} · ${n}</span>`).join("")}
function popup(t){const d=document.createElement("div");d.className="pop";d.textContent=t;document.body.appendChild(d);setTimeout(()=>d.remove(),1400)}
function addPts(n,label){const before=getPts(),after=before+n;store("rg-points-"+LEVEL,String(after));ROUNDPTS+=n;drawPts();
 const nb=BADGES.find(([x])=>before<x&&after>=x);popup(nb?`New badge: ${nb[1]}!`:`+${n}${label?" "+label:""}`)}
function right(){STREAK++;let n=10,l="";if(STREAK>=3){n+=5;l=`🔥 ${STREAK} in a row!`}addPts(n,l)}
function wrong(){STREAK=0}
let ROUNDPTS=0;
/* ---------- STATE ---------- */
const RATES=[0.55,0.72,0.9];let RATE=1;
function setRate(r){RATE=r;[0,1,2].forEach(i=>$("sp"+i).classList.toggle("on",i===r));store("rg-rate",String(r));speak("This is the speed.")}
let LEVEL = 1, GAME = null, Q = [], qi = 0, score = 0, total = 0, missed = [];
const GAMES = [
 {id:"sort",ic:"⚖️",h:"CAN or SHOULD?",p:"Is it a right or a responsibility?"},
 {id:"fair",ic:"🤔",h:"FAIR or NOT FAIR?",p:"Read the situation. Is it fair?"},
 {id:"case",ic:"📖",h:"Case studies",p:"Read about Blessing, Ahmed and Pavel."},
 {id:"build",ic:"🧩",h:"Build the sentence",p:"Put the words in order."},
 {id:"speak",ic:"🎤",h:"Speaking cards",p:"Work with a partner. Say the sentence."}
];

function store(k,v){try{ if(v===undefined) return localStorage.getItem(k); localStorage.setItem(k,v);}catch(e){return null}}
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function esc(s){return s.replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]))}
let SPK=0,CT=null;
function utter(t,done){try{const s=window.speechSynthesis;if(!s||!t.trim()){done&&done();return}const u=new SpeechSynthesisUtterance(t);u.lang="en-GB";u.rate=RATES[RATE];const vs=s.getVoices().filter(v=>v.lang==="en-GB"||v.lang==="en_GB");const v=(navigator.onLine?null:vs.find(v=>v.localService))||vs[0];if(v)u.voice=v;if(done)u.onend=done;s.speak(u)}catch(e){done&&done()}}
function speak(t){const id=++SPK;clearInterval(CT);try{speechSynthesis.cancel()}catch(e){}
 if(t.includes("___")){const [a,b]=t.split("___");
  utter(a,()=>{if(id!==SPK)return;let n=7;const g=$("gap");const show=()=>{if(g&&id===SPK&&!g.dataset.done){g.textContent=n>0?n:"?";g.classList.toggle("count",n>0)}};show();
   CT=setInterval(()=>{if(id!==SPK){clearInterval(CT);return}n--;show();if(n<=0){clearInterval(CT);utter(b)}},1000)})}
 else utter(t)}
function sayBtn(t){return `<button class="say" onclick='speak(${JSON.stringify(t).replace(/'/g,"&#39;")})'>🔊 Listen</button>`}
function pron(t,p){const m=p.g==="m";return t.replace(/\{his\}/g,m?"his":"her").replace(/\{he\}/g,m?"he":"she").replace(/\{him\}/g,m?"him":"her")}
const $=id=>document.getElementById(id);

function setLevel(l){LEVEL=l;$("lv1").classList.toggle("on",l===1);$("lv2").classList.toggle("on",l===2);store("rg-level",String(l));home()}
function home(){SPK++;clearInterval(CT);try{speechSynthesis.cancel()}catch(e){}drawPts();
 $("home").classList.remove("hide");$("play").classList.add("hide");
 $("menu").innerHTML=GAMES.map(g=>{const b=store(`rg-best-${g.id}-${LEVEL}`);
  return `<button class="game" onclick="start('${g.id}')"><span class="ic">${g.ic}</span><span><h2>${g.h}</h2><p>${g.p}</p></span>${b&&g.id!=="speak"?`<span class="best">Best: ${b}</span>`:""}</button>`}).join("")}
function prog(){const n=GAME==="speak"?0:Q.length;$("progFill").style.width=n?(qi/n*100)+"%":"0";$("count").textContent=n?`${Math.min(qi+1,n)} / ${n}`:""}

function start(id){GAME=id;qi=0;score=0;total=0;missed=[];ROUNDPTS=0;STREAK=0;
 $("home").classList.add("hide");$("play").classList.remove("hide");
 if(id==="sort"){const pool=ITEMS.filter(x=>LEVEL===2||!x.l);Q=shuffle(pool).slice(0,LEVEL===1?12:16).map(sortQ)}
 if(id==="fair"){Q=shuffle(FAIR).slice(0,LEVEL===1?10:12).map(fairQ)}
 if(id==="case"){return caseMenu()}
 if(id==="build"){Q=shuffle(BUILD[LEVEL]);return buildShow()}
 if(id==="speak"){return speakShow()}
 mcShow()}

/* ---------- MULTIPLE CHOICE ENGINE ---------- */
function sortQ(x){const s=x.s||`You ___ ${x.t}.`;
 return {e:x.e,prompt:s,opts:["CAN","SHOULD"],ans:x.k,
  done:s.replace("___",x.k.toLowerCase()),why:x.why,
  label:(x.k==="CAN"?"Right":"Responsibility")}}
function fairQ(x){return {e:x.e,prompt:x.t,opts:["FAIR","NOT FAIR"],ans:x.k,done:x.t,why:x.why.startsWith("Careful")?x.why:(x.k==="FAIR"?"It is fair because ":"It is not fair because ")+x.why.charAt(0).toLowerCase()+x.why.slice(1),kind:x.kind}}

function mcShow(extraTop){
 if(qi>=Q.length) return endShow();
 prog();const q=Q[qi];
 const promptHtml=q.prompt.includes("___")?esc(q.prompt).replace("___",'<span class="gap" id="gap">?</span>'):esc(q.prompt);
 $("stage").innerHTML=`${extraTop||""}<div class="card"><div class="emoji" aria-hidden="true">${q.e||""}</div>
  <p class="q">${promptHtml}</p>${sayBtn(q.prompt)}</div>
  <div class="opts">${q.opts.map(o=>`<button class="opt ${cls(o)}" onclick="mcPick(this,'${o}')">${o}</button>`).join("")}</div>
  <div class="fb" id="fb"></div>`}
function cls(o){return (o==="CAN"||o==="RIGHT"||o==="FAIR")?"can":(o==="SHOULD"||o==="RESPONSIBILITY"||o==="NOT FAIR")?"should":""}
function mcPick(btn,o){const q=Q[qi];total++;
 document.querySelectorAll(".opt").forEach(b=>{b.disabled=true;if(b.textContent===q.ans)b.classList.add("right")});
 const ok=o===q.ans;if(ok){score++;right()}else{wrong();btn.classList.add("wrong");missed.push(`${q.done} → ${q.ans}`)}
 const gap=$("gap");if(gap){gap.dataset.done="1";gap.classList.remove("count");gap.textContent=q.ans.toLowerCase();gap.classList.add(q.ans==="CAN"?"can":"should")}
 let extra="";
 if(q.kindStep) extra=`<br>${KIND_WHY[q.ans]}`;
 else if(LEVEL===2&&q.label) extra=`<br><em>It is a ${q.label.toLowerCase()}, so you ${q.ans==="CAN"?"are allowed to do it":"are expected to do it"}.</em>`;
 const fb=$("fb");fb.className="fb show "+(ok?"ok":"no");
 fb.innerHTML=`<strong>${ok?"✅ Well done!":"❌ Not quite. The answer is "+q.ans+"."}</strong>${q.kindStep?"":esc(q.done)+"<br>"}${esc(q.why||"")}${extra}
  <br><button class="next" onclick="mcNext()">Next ▶</button>`;
 speak(q.kindStep?KIND_WHY[q.ans]:q.done+" "+(q.why||""));
 // Entry 2 discrimination follow-up
 if(GAME==="fair"&&LEVEL===2&&q.kind&&q.ans==="NOT FAIR"&&!q.kindStep){
  Q.splice(qi+1,0,{e:"🔎",prompt:"What kind of discrimination is it? "+q.prompt,opts:["race","age","sex","religion"],ans:q.kind,done:q.prompt,why:"",kindStep:true})}
 $("fb").querySelector(".next").focus()}
function mcNext(){qi++;GAME==="case"?caseStep():mcShow()}

/* ---------- CASE STUDIES ---------- */
let CASE=null;
function caseMenu(){$("count").textContent="";$("progFill").style.width="0";
 $("stage").innerHTML=`<div class="card"><p class="q">Choose a person.</p><p class="lead" style="margin:0">Read the text. Then choose RIGHT or RESPONSIBILITY.</p></div>
  <div class="menu">${CASES[LEVEL].map((c,i)=>{const b=store(`rg-best-case${i}-${LEVEL}`);return `<button class="game" onclick="caseStart(${i})"><span class="ic">${c.e}</span><span><h2>${c.name}</h2></span>${b?`<span class="best">Best: ${b}</span>`:""}</button>`}).join("")}</div>`}
function caseStart(i){CASE=i;qi=0;score=0;total=0;missed=[];ROUNDPTS=0;STREAK=0;const c=CASES[LEVEL][i];
 Q=shuffle(c.st).map(s=>({prompt:s[0],opts:["RIGHT","RESPONSIBILITY"],ans:s[1],done:s[0],why:s[1]==="RIGHT"?"This is something they CAN do.":"This is something people SHOULD do."}));caseStep()}
function caseStep(){const c=CASES[LEVEL][CASE];
 mcShow(`<div class="card"><div class="persona"><span aria-hidden="true">${c.e}</span><strong>${c.name}</strong></div><div class="text">${esc(c.text)}</div>${sayBtn(c.text)}</div>`)}

/* ---------- BUILD ---------- */
let placed=[],pool=[];
function buildShow(){if(qi>=Q.length)return endShow();prog();
 const words=Q[qi].split(" ");placed=[];pool=shuffle(words.map((w,i)=>({w,i})));
 if(pool.every((p,i)=>p.i===i)&&pool.length>1)pool.reverse();buildDraw()}
function buildDraw(){const s=Q[qi];
 $("stage").innerHTML=`<div class="card"><p class="q">Put the words in order.</p>
  <p class="frame">Start with a capital letter. End with a full stop.</p>
  <div class="slot" aria-label="Your sentence">${placed.map((p,k)=>`<button class="tile" onclick="unplace(${k})">${esc(p.w)}</button>`).join("")||'<span class="frame">Tap the words below.</span>'}</div>
  <div class="tiles">${pool.map((p,k)=>`<button class="tile" onclick="place(${k})">${esc(p.w)}</button>`).join("")}</div>
  <div class="row"><button class="next" onclick="buildCheck()" ${pool.length?"disabled":""}>Check</button><button class="ghost" onclick="buildReset()">Start again</button>${sayBtn(s).replace("🔊 Listen","🔊 Hint")}</div></div><div class="fb" id="fb"></div>`}
function place(k){placed.push(pool.splice(k,1)[0]);buildDraw()}
function unplace(k){pool.push(placed.splice(k,1)[0]);buildDraw()}
function buildReset(){pool=shuffle(pool.concat(placed));placed=[];buildDraw()}
function buildCheck(){const s=Q[qi],got=placed.map(p=>p.w).join(" "),ok=got===s;total++;if(ok){score++;right()}else{wrong();missed.push(s)}
 const fb=$("fb");fb.className="fb show "+(ok?"ok":"no");
 fb.innerHTML=`<strong>${ok?"✅ Well done!":"❌ Not quite."}</strong>${ok?"":"You wrote: "+esc(got)+"<br>"}Correct: <b>${esc(s)}</b><br><button class="next" onclick="qi++;buildShow()">Next ▶</button>`;
 document.querySelectorAll(".tile,.ghost").forEach(b=>b.disabled=true);document.querySelector(".row .next").disabled=true;speak(s)}

/* ---------- SPEAKING ---------- */
function speakShow(){$("count").textContent="";$("progFill").style.width="0";
 const p=PEOPLE[Math.floor(Math.random()*PEOPLE.length)];
 const pool=ITEMS.filter(x=>x.sp!==false&&(LEVEL===2||!x.l));const it=pool[Math.floor(Math.random()*pool.length)];
 const verb=it.k.toLowerCase(),act=pron(it.t3,p);
 const model=LEVEL===1?`${p.n} ${verb} ${act}.`:`${p.n} ${verb} ${act} because ${pron(it.r,p)}.`;
 const frame=LEVEL===1?`${p.n} can … / ${p.n} should …`:`${p.n} can / should … because …`;
 $("stage").innerHTML=`<div class="card"><div class="persona"><span aria-hidden="true">${p.e}</span><span class="big">${esc(p.n)}</span></div>
  <div class="emoji" aria-hidden="true">${it.e}</div><p class="q">${esc(act)}</p>
  <p class="frame">Say: ${esc(frame)}</p>${LEVEL===2?'<p class="frame">Partner: is it a right or a responsibility? Why?</p>':""}
  <div class="row"><button class="next" onclick="speakReveal()">Check</button><button class="ghost" id="saidBtn" onclick="said()">✅ We said it! +5</button><button class="ghost" onclick="speakShow()">New card</button></div>
  <div class="model hide" id="model">${esc(model)}<br><span style="font-weight:400">${it.k==="CAN"?"A right.":"A responsibility."}</span></div></div>`;
 $("model").dataset.say=model}
function said(){const b=$("saidBtn");if(b.disabled)return;b.disabled=true;addPts(5,"");}
function speakReveal(){const m=$("model");m.classList.remove("hide");speak(m.dataset.say)}

/* ---------- END ---------- */
let LAST="";
function resultsText(){const n=($("rName")||{}).value||"";return `Rights and Responsibilities game\nName: ${n}\nLevel: Entry ${LEVEL}\n${LAST}`}
function mailResults(){const m=$("rMail").value.trim(),n=$("rName").value.trim();
 if(!n){$("mailMsg").textContent="Please write your name.";return}
 if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(m)){$("mailMsg").textContent="Please check the email address.";return}
 store("rg-name",n);store("rg-mail",m);
 location.href=`mailto:${encodeURIComponent(m)}?subject=${encodeURIComponent("My results – Rights game – "+n)}&body=${encodeURIComponent(resultsText())}`;
 $("mailMsg").textContent="Your email app should open now. Press Send."}
function copyResults(){const t=resultsText();try{navigator.clipboard.writeText(t).then(()=>{$("mailMsg").textContent="Copied! Paste it into an email or message."})}catch(e){$("mailMsg").textContent="Copy did not work."}}
function endShow(){$("progFill").style.width="100%";$("count").textContent="";
 const pct=total?score/total:0,st=pct>=.9?3:pct>=.7?2:1;
 const gname=(GAMES.find(g=>g.id===GAME)||{}).h+(GAME==="case"?" – "+CASES[LEVEL][CASE].name:"");
 LAST=`Game: ${gname}\nDate: ${new Date().toLocaleDateString("en-GB")}\nScore: ${score} / ${total}\nStars: ${"★".repeat(st)}${"☆".repeat(3-st)}\nPoints this game: ${ROUNDPTS}\nTotal points: ${getPts()}`+(missed.length?`\n\nCheck these again:\n- ${missed.join("\n- ")}`:"");
 const key=GAME==="case"?`rg-best-case${CASE}-${LEVEL}`:`rg-best-${GAME}-${LEVEL}`;
 const prev=store(key),best=prev?Math.max(parseInt(prev),score):score;store(key,best+"/"+total);
 $("stage").innerHTML=`<div class="card" style="text-align:center"><div class="stars" aria-label="${st} stars">${"★".repeat(st)}${"☆".repeat(3-st)}</div>
  <p class="big">${score} / ${total}</p><p>⭐ +${ROUNDPTS} points this game</p><p>${st===3?"Excellent!":st===2?"Good work!":"Keep practising!"}</p></div>
  ${missed.length?`<div class="card"><strong>Check these again:</strong><ul class="review">${missed.map(m=>`<li>${esc(m)}</li>`).join("")}</ul></div>`:""}
  <div class="card noprint"><strong>📧 Email my results</strong>
   <p class="frame" style="margin-top:4px">Write your name and an email address. Your email app opens. Then press Send.</p>
   <input class="url" id="rName" placeholder="Your name" value="${esc(store('rg-name')||'')}" style="margin-bottom:8px">
   <input class="url" id="rMail" type="email" placeholder="Email address" value="${esc(store('rg-mail')||'')}">
   <div class="row"><button class="next" onclick="mailResults()">📧 Email</button><button class="ghost" onclick="copyResults()">📋 Copy</button></div>
   <p class="frame" id="mailMsg"></p></div>
  <div class="row"><button class="next" onclick="${GAME==="case"?`caseStart(${CASE})`:`start('${GAME}')`}">Play again</button>${GAME==="case"?'<button class="ghost" onclick="caseMenu()">Another person</button>':""}<button class="ghost" onclick="home()">All games</button></div>`}

/* ---------- TEACHER ---------- */
function teacher(){$("home").classList.add("hide");$("play").classList.remove("hide");$("count").textContent="";$("progFill").style.width="0";
 const here=/^https?:/.test(location.protocol)&&!/claude\.ai|claudeusercontent/.test(location.host)?location.origin+location.pathname:"";
 $("stage").innerHTML=`<div class="card noprint"><p class="q">QR codes for learners</p>
  <p class="frame">Paste the web address where the game is online. Each code opens the game at one level, with the level switch hidden.</p>
  <input class="url" id="qrUrl" placeholder="https://..." value="${esc(here)}">
  <div class="row"><button class="next" onclick="makeQR()">Make QR codes</button><button class="ghost" onclick="window.print()">🖨️ Print</button></div>
  <p class="frame" id="qrMsg"></p></div>
  <div class="qrs" id="qrs"></div>
  <div class="card noprint" style="margin-top:16px"><p class="q">Points</p><p class="frame">Points are saved on this device. Entry 1: ${store("rg-points-1")||0} · Entry 2: ${store("rg-points-2")||0}</p>
  <div class="row"><button class="ghost" onclick="if(confirm('Reset all points and best scores on this device?')){resetAll()}">Reset points on this device</button></div></div>`}
function resetAll(){try{Object.keys(localStorage).filter(k=>k.startsWith("rg-points")||k.startsWith("rg-best")).forEach(k=>localStorage.removeItem(k))}catch(e){}teacher()}
function loadQR(cb){if(window.QRCode)return cb();const sc=document.createElement("script");sc.src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js";sc.onload=cb;sc.onerror=()=>{$("qrMsg").textContent="Could not load the QR maker. Please connect to the internet and try again."};document.head.appendChild(sc)}
function makeQR(){const u=$("qrUrl").value.trim();if(!/^https?:\/\//.test(u)){$("qrMsg").textContent="Please paste a web address that starts with https://";return}
 const base=u.split("?")[0];$("qrMsg").textContent="";
 loadQR(()=>{$("qrs").innerHTML=[1,2].map(l=>`<div class="qrbox"><h3>Entry ${l}</h3><div class="qr" id="qr${l}"></div><p style="margin:4px 0;font-weight:700">Rights and Responsibilities game</p><small>${esc(base)}?level=${l}</small></div>`).join("");
  [1,2].forEach(l=>new QRCode($("qr"+l),{text:`${base}?level=${l}`,width:220,height:220,correctLevel:QRCode.CorrectLevel.M}))})}
/* ---------- INIT ---------- */
const sr=store("rg-rate");if(sr!==null&&sr!==undefined&&RATES[+sr])RATE=+sr;[0,1,2].forEach(i=>$("sp"+i).classList.toggle("on",i===RATE));
const qpl=new URLSearchParams(location.search).get("level");
if(qpl==="1"||qpl==="2"){LEVEL=+qpl;$("levelSw").classList.add("hide")}else{const saved=store("rg-level");if(saved==="2")LEVEL=2;}
$("lv1").classList.toggle("on",LEVEL===1);$("lv2").classList.toggle("on",LEVEL===2);home();
try{speechSynthesis.getVoices()}catch(e){}
</script>
</body>
</html>
